---
// 全站基础布局：由旧版 index.html / article.html 模板的公共外壳 1:1 移植。
// 页面差异（SEO meta、JSON-LD、不蒜子统计、head 附加标签）通过 Props 与 head slot 注入；
// 脚本一律用 Fragment set:html 原文输出，避免 Astro 改写执行时机。
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogSiteName?: string;
  twitterCard?: string;
  ogImage?: string;
  jsonLd?: string;
  busuanzi?: boolean;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogUrl,
  ogSiteName = "xundei's blog",
  twitterCard = 'summary',
  ogImage,
  jsonLd,
  busuanzi = true,
} = Astro.props;

// 主题初始化脚本：按时间段自动定主题，18:00–6:00 夜间（黄昏），其余为白天（清晨）。
// 必须在首帧渲染前进 documentElement 加类，故保持 head 内联执行。
const themeInitScript = `  <script>
    // 按时间段自动定主题：18:00–6:00 夜间（黄昏），其余为白天（清晨）
    (function () {
      var h = new Date().getHours();
      document.documentElement.classList.add(h >= 18 || h < 6 ? 'theme-dark' : 'theme-light');
    })();
  </script>`;

const busuanziScript =
  '  <script defer src="//cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js"></script>';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogTitle && ogDescription && <meta property="og:description" content={ogDescription} />}
  {ogTitle && <meta property="og:type" content={ogType} />}
  {ogTitle && ogUrl && <meta property="og:url" content={ogUrl} />}
  {ogTitle && <meta property="og:site_name" content={ogSiteName} />}
  {ogTitle && <meta name="twitter:card" content={twitterCard} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
  <link rel="preload" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>
  {busuanzi && <Fragment set:html={busuanziScript} />}
  <slot name="head" />
  <Fragment set:html={themeInitScript} />
</head>
<body>
  <div class="aurora-background" id="aurora-bg">
    <div class="aurora-orb aurora-orb-1"></div>
    <div class="aurora-orb aurora-orb-2"></div>
    <div class="aurora-orb aurora-orb-3"></div>
    <div class="aurora-orb aurora-orb-4"></div>
  </div>

  <!-- 亮度自适应调节层 -->
  <div class="brightness-overlay" id="brightness-overlay"></div>

  <slot />
</body>
</html>
