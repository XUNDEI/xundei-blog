---
// 搜索悬浮按钮 + 搜索面板（实时搜索、字段/时间筛选），行为由 home.js 驱动
---
<div class="search-toggle" id="search-toggle" role="button" aria-label="搜索">
  <i class="fas fa-search"></i>
  <span class="search-pulse"></span>
</div>

<div class="search-panel" id="search-panel">
  <div class="search-input-wrap">
    <i class="fas fa-search search-input-icon"></i>
    <input type="text" class="search-input" id="search-input" placeholder="搜索文章..." autocomplete="off" aria-label="搜索文章" />
    <button class="search-clear" id="search-clear" aria-label="清除搜索"><i class="fas fa-times"></i></button>
  </div>
  <div class="search-filters">
    <div class="filter-group">
      <span class="filter-label">搜索范围</span>
      <div class="checkbox-group">
        <label class="checkbox-item"><input type="checkbox" checked data-field="title" />标题</label>
        <label class="checkbox-item"><input type="checkbox" checked data-field="body" />正文</label>
        <label class="checkbox-item"><input type="checkbox" checked data-field="tags" />标签</label>
        <label class="checkbox-item"><input type="checkbox" checked data-field="excerpt" />简介</label>
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label">时间筛选</span>
      <div class="date-range" id="date-range">
        <div class="custom-date-picker" data-picker="from">
          <input type="text" class="date-input" id="date-from-display" placeholder="开始日期" readonly aria-label="开始日期" autocomplete="off" />
          <i class="fas fa-calendar-alt date-input-icon"></i>
          <div class="calendar-popup" id="calendar-from">
            <div class="calendar-nav">
              <button class="nav-btn" data-dir="-1"><i class="fas fa-chevron-left"></i></button>
              <span class="nav-title" id="cal-title-from">2024年1月</span>
              <button class="nav-btn" data-dir="1"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="calendar-weekdays">
              <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
            </div>
            <div class="calendar-days" id="cal-days-from"></div>
            <div class="calendar-footer">
              <button class="today-btn" data-today>今天</button>
              <button class="clear-date-btn" data-clear>清除</button>
            </div>
          </div>
        </div>
        <span class="date-sep">至</span>
        <div class="custom-date-picker" data-picker="to">
          <input type="text" class="date-input" id="date-to-display" placeholder="结束日期" readonly aria-label="结束日期" autocomplete="off" />
          <i class="fas fa-calendar-alt date-input-icon"></i>
          <div class="calendar-popup" id="calendar-to">
            <div class="calendar-nav">
              <button class="nav-btn" data-dir="-1"><i class="fas fa-chevron-left"></i></button>
              <span class="nav-title" id="cal-title-to">2024年1月</span>
              <button class="nav-btn" data-dir="1"><i class="fas fa-chevron-right"></i></button>
            </div>
            <div class="calendar-weekdays">
              <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
            </div>
            <div class="calendar-days" id="cal-days-to"></div>
            <div class="calendar-footer">
              <button class="today-btn" data-today>今天</button>
              <button class="clear-date-btn" data-clear>清除</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="search-info" id="search-info"></div>
</div>
