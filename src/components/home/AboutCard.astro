---
// 关于悬浮球 + 关于卡片（联系方式列表由 home.js 渲染，点击图标复制）
---
<div class="about-btn" id="about-btn">
  <i class="fas fa-user"></i>
</div>
<div class="about-card glass" id="about-card">
  <div class="about-header">
    <div style="display: flex; align-items: center;">
      <img src="./portrait.png" alt="Avatar" class="avatar" />
      <div class="about-name">迅dei</div>
    </div>
    <div class="close-about-btn" id="close-about-btn">
      <i class="fas fa-times"></i>
    </div>
  </div>
  <div class="contacts" id="contacts-container"></div>
  <p style="text-align: center; color: var(--w-80); font-size: 0.9rem; margin-top: 10px;">
    点击图标复制联系方式
  </p>
</div>
