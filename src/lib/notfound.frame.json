"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>页面未找到 - xundei's blog</title>\n    <link rel=\"preload\" href=\"https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css\" as=\"style\" onload=\"this.onload=null;this.rel='stylesheet'\" />\n    <noscript><link rel=\"stylesheet\" href=\"https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css\" /></noscript>\n    <style>\n        /* ===== 极光背景样式（已提亮） ===== */\n        :root {\n            --aurora-gradient: linear-gradient(135deg, #c8e8f3 0%, #e4d5e9 50%, #f0e0db 100%);\n            --aurora-primary: #7BA7BC;\n            --aurora-secondary: #C4A6C2;\n            --glass-bg: rgba(255, 255, 255, 0.25);\n            --glass-border: rgba(255, 255, 255, 0.35);\n            --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);\n            --primary-color: #4285F4;\n            --light-text: #fff;\n            --transition: all 0.3s ease;\n            --blur-amount: 12px;\n            --glow-color: rgba(66, 133, 244, 0.7);\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            min-height: 100vh;\n            background-size: cover;\n            background-position: center;\n            background-repeat: no-repeat;\n            background-attachment: fixed;\n            transition: background-image 1.5s ease-in-out;\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n        }\n\n        /* 极光背景容器 - 移除黑色叠加层 */\n        .aurora-background {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n            pointer-events: none;\n            overflow: hidden;\n            background: var(--aurora-gradient); /* 直接使用渐变，不加暗色遮罩 */\n            transition: opacity 0.8s ease;\n            opacity: 1;\n            will-change: opacity;\n        }\n        .aurora-background.fade-out {\n            opacity: 0;\n            transition: opacity 1.2s ease;\n        }\n        .aurora-background.hidden {\n            display: none;\n        }\n\n        .aurora-orb {\n            position: absolute;\n            border-radius: 50%;\n            pointer-events: none;\n            will-change: transform;\n        }\n        .aurora-orb-1 {\n            width: min(600px, 80vw);\n            height: min(600px, 80vw);\n            background: var(--aurora-primary);\n            opacity: 0.25;\n            filter: blur(120px);\n            left: 10%;\n            top: 5%;\n            animation: orb1-drift 22s ease-in-out infinite;\n        }\n        .aurora-orb-2 {\n            width: min(500px, 65vw);\n            height: min(500px, 65vw);\n            background: var(--aurora-secondary);\n            opacity: 0.20;\n            filter: blur(100px);\n            right: 5%;\n            bottom: 10%;\n            animation: orb2-drift 26s ease-in-out infinite;\n        }\n        .aurora-orb-3 {\n            width: min(450px, 55vw);\n            height: min(450px, 55vw);\n            background: var(--aurora-primary);\n            opacity: 0.15;\n            filter: blur(130px);\n            left: 40%;\n            top: 40%;\n            animation: orb3-drift 30s ease-in-out infinite;\n        }\n        .aurora-orb-4 {\n            width: min(300px, 40vw);\n            height: min(300px, 40vw);\n            background: var(--aurora-secondary);\n            opacity: 0.18;\n            filter: blur(80px);\n            left: 55%;\n            top: 15%;\n            animation: orb4-drift 18s ease-in-out infinite;\n        }\n\n        @keyframes orb1-drift {\n          0% { transform: translate(-5%, 0%) scale(1); }\n          33.3% { transform: translate(15%, 12%) scale(1.15); }\n          66.7% { transform: translate(5%, 20%) scale(0.9); }\n          100% { transform: translate(-8%, 3%) scale(1.08); }\n        }\n        @keyframes orb2-drift {\n          0% { transform: translate(8%, -5%) scale(0.9); }\n          33.3% { transform: translate(-10%, 10%) scale(1.12); }\n          66.7% { transform: translate(5%, -8%) scale(1); }\n          100% { transform: translate(12%, 5%) scale(1.08); }\n        }\n        @keyframes orb3-drift {\n          0% { transform: translate(-10%, -8%) scale(1.05); }\n          33.3% { transform: translate(20%, 5%) scale(0.88); }\n          66.7% { transform: translate(-5%, 15%) scale(1.1); }\n          100% { transform: translate(10%, -3%) scale(0.95); }\n        }\n        @keyframes orb4-drift {\n          0% { transform: translate(15%, 10%) scale(0.85); }\n          33.3% { transform: translate(-8%, -5%) scale(1.1); }\n          66.7% { transform: translate(10%, 8%) scale(0.95); }\n          100% { transform: translate(-12%, 15%) scale(1.05); }\n        }\n\n        /* ===== 404 页面样式 ===== */\n        .error-container {\n            position: relative;\n            z-index: 1;\n            max-width: 600px;\n            margin: 20px;\n            text-align: center;\n        }\n\n        .glass-card {\n            background: var(--glass-bg);\n            backdrop-filter: blur(var(--blur-amount));\n            -webkit-backdrop-filter: blur(var(--blur-amount));\n            border: 1px solid var(--glass-border);\n            border-radius: 24px;\n            box-shadow: var(--glass-shadow);\n            padding: 50px 40px;\n            transition: var(--transition);\n            color: var(--w-100);\n            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\n        }\n        .glass-card:hover {\n            box-shadow: 0 0 22px var(--glow-color), 0 0 45px rgba(66, 133, 244, 0.3);\n            border-color: rgba(255, 255, 255, 0.50);\n        }\n\n        .error-code {\n            font-size: 6rem;\n            font-weight: 800;\n            background: linear-gradient(90deg, #fff, #a1c4fd);\n            -webkit-background-clip: text;\n            background-clip: text;\n            color: transparent;\n            margin-bottom: 20px;\n        }\n\n        .error-title {\n            font-size: 2rem;\n            margin-bottom: 20px;\n        }\n\n        .error-message {\n            font-size: 1.1rem;\n            opacity: 0.95;\n            margin-bottom: 30px;\n            line-height: 1.6;\n        }\n\n        .home-btn {\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n            background: var(--primary-color);\n            color: white;\n            padding: 12px 28px;\n            border-radius: 40px;\n            text-decoration: none;\n            font-weight: 600;\n            transition: var(--transition);\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\n        }\n        .home-btn:hover {\n            background: #2b6de0;\n            transform: translateY(-3px);\n            box-shadow: 0 0 20px var(--glow-color);\n            letter-spacing: 0.5px;\n        }\n\n        @media (max-width: 768px) {\n            .glass-card { padding: 35px 25px; }\n            .error-code { font-size: 4rem; }\n            .error-title { font-size: 1.5rem; }\n            .error-message { font-size: 1rem; }\n        }\n    \n    /* ===== 亮/深色主题文字变量（默认深色值，html.theme-light 覆盖为深字浅底） ===== */\n    :root {\n      --w-100: #fff;\n      --w-50: rgba(255, 255, 255, 0.50);\n    }\n    html.theme-light {\n      --w-100: #2d3a4b;\n      --w-50: rgba(45, 58, 75, 0.50);\n      --text-color: #2d3a4b;\n      --glass-bg: rgba(255, 255, 255, 0.42);\n      --glass-border: rgba(255, 255, 255, 0.55);\n      --glass-shadow: 0 8px 32px rgba(70, 90, 120, 0.14);\n    }\n    \n    html.theme-light .error-code {\n        background: linear-gradient(90deg, #2d3a4b, #4285F4);\n        -webkit-background-clip: text;\n        background-clip: text;\n    }\n\n                                html.theme-dark {\n      --w-100: #F5EDE4;\n      --w-50: rgba(245, 237, 228, 0.50);\n      --text-color: #F5EDE4;\n      --aurora-gradient: linear-gradient(135deg, #F4C4A8 0%, #C9A0B6 50%, #5B6D8A 100%);\n      --aurora-primary: #E8A87C;\n      --aurora-secondary: #6B4E71;\n      --glass-bg: rgba(40, 30, 50, 0.35);\n      --glass-border: rgba(255, 255, 255, 0.1);\n    }\n\n\n/* 壁纸加载完成后：玻璃与文字恢复博客最初样式（与明暗主题无关） */\n    html.wallpaper-active {\n      --glass-bg: rgba(255, 255, 255, 0.25);\n      --glass-border: rgba(255, 255, 255, 0.35);\n      --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);\n      --w-100: #fff;\n      --w-50: rgba(255, 255, 255, 0.50);\n      --text-color: #fff;\n    }\n\n</style>\n  <script>\n    // 按时间段自动定主题：18:00–6:00 夜间（黄昏），其余为白天（清晨）\n    (function () {\n      var h = new Date().getHours();\n      document.documentElement.classList.add(h >= 18 || h < 6 ? 'theme-dark' : 'theme-light');\n    })();\n  </script>\n</head>\n<body>\n    <!-- 极光背景 -->\n    <div class=\"aurora-background\" id=\"aurora-bg\">\n        <div class=\"aurora-orb aurora-orb-1\"></div>\n        <div class=\"aurora-orb aurora-orb-2\"></div>\n        <div class=\"aurora-orb aurora-orb-3\"></div>\n        <div class=\"aurora-orb aurora-orb-4\"></div>\n    </div>\n\n\n    <div class=\"error-container\">\n        <div class=\"glass-card\">\n            <div class=\"error-code\">404</div>\n            <h1 class=\"error-title\">你来到了一片未知的领域</h1>\n            <p class=\"error-message\">保持好奇心是好事<br />但不是用在这里啊喂</p>\n            <a href=\"/\" class=\"home-btn\">\n                <i class=\"fas fa-home\"></i> 返回首页\n            </a>\n        </div>\n    </div>\n\n    <script>\n        // ===== 壁纸加载逻辑（仅从 wallpaper.json） =====\n        (function() {\n            var auroraBg = document.getElementById('aurora-bg');\n\n            function hideAuroraBackground() {\n                if (!auroraBg || auroraBg.classList.contains('hidden')) return;\n                                auroraBg.classList.add('fade-out');\n                setTimeout(function() {\n                    auroraBg.classList.add('hidden');\n                    auroraBg.style.display = 'none';\n                }, 1200);\n            }\n\n            // 加载壁纸（仅从 wallpaper.json）\n            function loadWallpaperFromConfig() {\n                return new Promise(function(resolve) {\n                    fetch('/wallpaper.json')\n                        .then(function(response) {\n                            if (!response.ok) throw new Error('请求失败');\n                            return response.json();\n                        })\n                        .then(function(data) {\n                            if (data && data.length) {\n                                var entry = data[Math.floor(Math.random() * data.length)];\n                                var imgUrl = entry.path;\n                                if (!/^https?:\\/\\//i.test(imgUrl)) {\n                                    imgUrl = './' + imgUrl;\n                                }\n                                var timestamp = new Date().getTime();\n                                imgUrl += (imgUrl.indexOf('?') === -1 ? '?' : '&') + 't=' + timestamp;\n\n                                var img = new Image();\n                                img.onload = function() {\n                                    document.body.style.backgroundImage = 'url(' + imgUrl + ')';\n                                    document.documentElement.classList.add('wallpaper-active');\n                                    hideAuroraBackground();\n                                    resolve(true);\n                                };\n                                img.onerror = function() {\n                                    resolve(false);\n                                };\n                                img.src = imgUrl;\n                            } else {\n                                resolve(false);\n                            }\n                        })\n                        .catch(function() {\n                            resolve(false);\n                        });\n                });\n            }\n\n            loadWallpaperFromConfig().then(function(ok) {\n                if (!ok) {\n                    console.log('壁纸加载失败，保留提亮后的极光背景');\n                }\n            });\n        })();\n    </script>\n\n</body>\n</html>"