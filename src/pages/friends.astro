---
// 友链独立页 /friends（数据来自 src/data/friends.json，原 friend_link.md 的内容完整保留）。
// 布局：桌面 3 列 / 平板 2 列 / 手机 1 列；样式沿用全站 glass/极光体系，配色取现有变量与色值。
import friendsData from '../data/friends.json';

interface Friend {
  name: string;
  url: string;
  description: string;
  icon?: string; // 手动指定 favicon 地址（可选，自动获取失败时使用）
}

const { title, intro } = friendsData;
const friends = friendsData.friends as Friend[];

// favicon 来源优先级：手动 icon 字段 > 对方站点根目录 /favicon.ico > favicon.im 代理 > 回退链接图标
function faviconSources(f: Friend): string[] {
  const sources: string[] = [];
  if (f.icon) {
    sources.push(f.icon);
  } else {
    const u = new URL(f.url);
    sources.push(u.origin + '/favicon.ico');
    sources.push('https://favicon.im/' + u.hostname + '?larger=true');
  }
  return sources;
}
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - xundei's blog</title>
    <meta name="description" content={intro} />
    <link rel="canonical" href="https://xundei.qzz.io/friends" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline>
      // 按时间段自动定主题：18:00–6:00 夜间（黄昏），其余为白天（清晨）
      (function () {
        var h = new Date().getHours();
        document.documentElement.classList.add(h >= 18 || h < 6 ? 'theme-dark' : 'theme-light');
      })();
    </script>
    <link
      rel="preload"
      href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>
    <style is:inline>
      :root {
        --aurora-gradient: linear-gradient(135deg, #B8D8E3 0%, #D4C5D9 50%, #E8D5D0 100%);
        --aurora-primary: #7BA7BC;
        --aurora-secondary: #C4A6C2;
        --glass-bg: rgba(255, 255, 255, 0.25);
        --glass-border: rgba(255, 255, 255, 0.35);
        --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
        --primary-color: #4285F4;
        --light-text: #fff;
        --transition: all 0.3s ease;
        --blur-amount: 12px;
        --glow-color: rgba(66, 133, 244, 0.7);
        --glow-strong: 0 0 22px rgba(66, 133, 244, 0.55), 0 0 45px rgba(66, 133, 244, 0.3), 0 0 75px rgba(66, 133, 244, 0.15);
      }

      /* ===== 亮/深色主题文字变量（默认深色值，html.theme-light 覆盖为深字浅底） ===== */
      :root {
        --w-100: #fff;
        --w-90: rgba(255, 255, 255, 0.9);
        --w-85: rgba(255, 255, 255, 0.85);
        --w-70: rgba(255, 255, 255, 0.7);
        --w-60: rgba(255, 255, 255, 0.6);
      }
      html.theme-light {
        --w-100: #2d3a4b;
        --w-90: rgba(45, 58, 75, 0.9);
        --w-85: rgba(45, 58, 75, 0.85);
        --w-70: rgba(45, 58, 75, 0.7);
        --w-60: rgba(45, 58, 75, 0.6);
        --glass-bg: rgba(255, 255, 255, 0.42);
        --glass-border: rgba(255, 255, 255, 0.55);
        --glass-shadow: 0 8px 32px rgba(70, 90, 120, 0.14);
      }
                              html.theme-dark {
      --w-100: #F5EDE4;
      --w-90: rgba(245, 237, 228, 0.90);
      --w-85: rgba(245, 237, 228, 0.85);
      --w-70: rgba(245, 237, 228, 0.70);
      --w-60: rgba(245, 237, 228, 0.60);
      --text-color: #F5EDE4;
      --aurora-gradient: linear-gradient(135deg, #F4C4A8 0%, #C9A0B6 50%, #5B6D8A 100%);
      --aurora-primary: #E8A87C;
      --aurora-secondary: #6B4E71;
      --glass-bg: rgba(40, 30, 50, 0.35);
      --glass-border: rgba(255, 255, 255, 0.1);
    }


/* 壁纸加载完成后：玻璃与文字恢复博客最初样式（与明暗主题无关） */
    html.wallpaper-active {
      --glass-bg: rgba(255, 255, 255, 0.25);
      --glass-border: rgba(255, 255, 255, 0.35);
      --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
      --w-100: #fff;
      --w-90: rgba(255, 255, 255, 0.90);
      --w-85: rgba(255, 255, 255, 0.85);
      --w-70: rgba(255, 255, 255, 0.70);
      --w-60: rgba(255, 255, 255, 0.60);
      --text-color: #fff;
    }


      * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

      body {
        min-height: 100vh;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
        transition: background-image 1.5s ease-in-out;
        color: var(--w-100);
        position: relative;
        overflow-x: hidden;
      }

      .aurora-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        background: var(--aurora-gradient);
        transition: opacity 0.8s ease;
        opacity: 1;
        will-change: opacity;
      }
      .aurora-background.fade-out { opacity: 0; transition: opacity 1.2s ease; }
      .aurora-background.hidden { display: none; }
      .aurora-orb { position: absolute; border-radius: 50%; pointer-events: none; will-change: transform; }
      .aurora-orb-1 { width: min(600px, 80vw); height: min(600px, 80vw); background: var(--aurora-primary); opacity: 0.25; filter: blur(120px); left: 10%; top: 5%; animation: orb1-drift 22s ease-in-out infinite; }
      .aurora-orb-2 { width: min(500px, 65vw); height: min(500px, 65vw); background: var(--aurora-secondary); opacity: 0.2; filter: blur(100px); right: 5%; bottom: 10%; animation: orb2-drift 26s ease-in-out infinite; }
      .aurora-orb-3 { width: min(450px, 55vw); height: min(450px, 55vw); background: var(--aurora-primary); opacity: 0.15; filter: blur(130px); left: 40%; top: 40%; animation: orb3-drift 30s ease-in-out infinite; }
      .aurora-orb-4 { width: min(300px, 40vw); height: min(300px, 40vw); background: var(--aurora-secondary); opacity: 0.18; filter: blur(80px); left: 55%; top: 15%; animation: orb4-drift 18s ease-in-out infinite; }
      @keyframes orb1-drift {
        0% { transform: translate(-5%, 0%) scale(1); }
        33.3% { transform: translate(15%, 12%) scale(1.15); }
        66.7% { transform: translate(5%, 20%) scale(0.9); }
        100% { transform: translate(-8%, 3%) scale(1.08); }
      }
      @keyframes orb2-drift {
        0% { transform: translate(8%, -5%) scale(0.9); }
        33.3% { transform: translate(-10%, 10%) scale(1.12); }
        66.7% { transform: translate(5%, -8%) scale(1); }
        100% { transform: translate(12%, 5%) scale(1.08); }
      }

      .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(var(--blur-amount));
        -webkit-backdrop-filter: blur(var(--blur-amount));
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        box-shadow: var(--glass-shadow);
        padding: 20px;
        transition: var(--transition);
      }
      .glass:hover {
        box-shadow: var(--glow-strong);
        border-color: rgba(255, 255, 255, 0.5);
      }

      .back-btn {
        position: fixed;
        top: 20px;
        left: 20px;
        background: var(--primary-color);
        border: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 100;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }
      .back-btn:hover { transform: scale(1.1); box-shadow: 0 0 20px var(--glow-color); }

      .container { max-width: 1200px; margin: 0 auto; padding: 20px; position: relative; z-index: 1; }

      .friends-header {
        text-align: center;
        margin: 20px 0 30px;
        animation: fadeInDown 1s ease;
      }
      .friends-title {
        font-size: 2.6rem;
        font-weight: 800;
        color: var(--w-100);
        margin-bottom: 12px;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      }
      html.theme-light .friends-title,
      html.theme-light .friends-intro {
        text-shadow: none;
      }
      .friends-intro {
        font-size: 1.05rem;
        font-weight: 300;
        color: var(--w-100);
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
      }

      .friends-grid {
        display: grid;
        grid-template-columns: repeat(1, 1fr);
        gap: 25px;
        margin-bottom: 30px;
      }
      @media (min-width: 768px) {
        .friends-grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (min-width: 1024px) {
        .friends-grid { grid-template-columns: repeat(3, 1fr); }
      }

      .friend-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
        padding: 28px 20px 24px;
        color: var(--w-100);
        text-decoration: none;
        min-height: 200px;
      }
      .friend-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(66, 133, 244, 0.2);
        border: 1px solid rgba(66, 133, 244, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--primary-color);
        transition: var(--transition);
        overflow: hidden;
      }
      .friend-favicon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        object-fit: contain;
      }
      .friend-card:hover .friend-icon {
        background: var(--primary-color);
        color: #fff;
        box-shadow: 0 0 18px var(--glow-color);
        transform: translateY(-3px);
      }
      .friend-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--w-100);
        line-height: 1.4;
      }
      .friend-desc {
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--w-85);
        flex-grow: 1;
      }
      .friend-url {
        font-size: 0.78rem;
        color: var(--w-60);
        word-break: break-all;
        letter-spacing: 0.3px;
      }

      .friends-footer {
        text-align: center;
        padding: 16px 20px;
        color: var(--w-70);
        font-size: 0.85rem;
      }
      .friends-footer a {
        color: var(--primary-color);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @media (max-width: 768px) {
        .friends-title { font-size: 2rem; }
        .back-btn { top: 15px; left: 15px; width: 45px; height: 45px; }
      }

      ::selection { background: rgba(66, 133, 244, 0.3); color: var(--w-100); }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.1); border-radius: 10px; }
      ::-webkit-scrollbar-thumb { background: rgba(66, 133, 244, 0.5); border-radius: 10px; border: 2px solid transparent; background-clip: content-box; }
      ::-webkit-scrollbar-thumb:hover { background: rgba(66, 133, 244, 0.7); }
      * { scrollbar-width: thin; scrollbar-color: rgba(66, 133, 244, 0.5) rgba(0, 0, 0, 0.1); }
    </style>
  </head>
  <body>
    <div class="aurora-background" id="aurora-bg">
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-orb aurora-orb-4"></div>
    </div>


    <a href="/" class="back-btn" aria-label="返回首页">
      <i class="fas fa-arrow-left"></i>
    </a>

    <div class="container">
      <header class="glass friends-header">
        <h1 class="friends-title">{title}</h1>
        <p class="friends-intro">{intro}</p>
      </header>

      <main class="friends-grid">
        {
          friends.map((f) => {
            const sources = faviconSources(f);
            // 逐级回退：最后一个来源失败后隐藏 img、显示原链接图标
            const onerror = `var s=${JSON.stringify(sources.slice(1))};var n=+(this.dataset.n||0);if(n<s.length){this.dataset.n=n+1;this.src=s[n];}else{this.style.display='none';this.nextElementSibling.style.display='inline-block';}`;
            return (
              <a class="friend-card glass" href={f.url} target="_blank" rel="noopener noreferrer" title={f.name}>
                <div class="friend-icon">
                  <img
                    class="friend-favicon"
                    src={sources[0]}
                    alt=""
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    onerror={onerror}
                  />
                  <i class="fas fa-link" style="display:none;" />
                </div>
                <div class="friend-name">{f.name}</div>
                <p class="friend-desc">{f.description}</p>
                <span class="friend-url">{f.url}</span>
              </a>
            );
          })
        }
      </main>
    </div>

    <script is:inline>
      // 壁纸为主背景，极光仅作加载失败后备（与首页一致）
      (function () {
        var auroraBg = document.getElementById('aurora-bg');
        function hideAuroraBackground() {
          if (!auroraBg || auroraBg.classList.contains('hidden')) return;
          auroraBg.classList.add('fade-out');
          setTimeout(function () {
            auroraBg.classList.add('hidden');
            auroraBg.style.display = 'none';
          }, 1200);
        }

        fetch('/wallpaper.json')
          .then(function (r) {
            if (!r.ok) throw new Error('请求失败');
            return r.json();
          })
          .then(function (data) {
            if (data && data.length) {
              var entry = data[Math.floor(Math.random() * data.length)];
              var imgUrl = entry.path;
              if (!/^https?:\/\//i.test(imgUrl)) imgUrl = './' + imgUrl;
              var img = new Image();
              img.onload = function () {
                document.body.style.backgroundImage = 'url(' + imgUrl + ')';
                document.documentElement.classList.add('wallpaper-active');
                hideAuroraBackground();
              };
              img.src = imgUrl;
            }
          })
          .catch(function () {
            /* 壁纸加载失败时保留极光背景 */
          });
      })();
    </script>

  </body>
</html>
