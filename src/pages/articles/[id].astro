---
// 文章页 /articles/{id}：结构与样式已从旧版 article 模板移植为 Layout + 组件 + article.css / article.js。
// 生成逻辑（阅读时长、SEO 标签、协议、标签 HTML）复刻自 build.js；
// 正文由 Astro 内置 Markdown 渲染并后处理成与旧版 marked 输出一致的形状。
import { getPublishedPosts } from '../../lib/posts';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import PostBody from '../../components/PostBody.astro';
import Giscus from '../../components/Giscus.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoadingOverlay from '../../components/LoadingOverlay.astro';
import ArticleOverlays from '../../components/article/ArticleOverlays.astro';
import articleJs from '../../scripts/article.js?raw';
import '../../styles/article.css';
import {
  getCategoryName,
  normalizeTags,
  calcReadingTime,
  generateSEOTags,
  getLicenseDisplayAndHtml,
  markedizeAstroHtml,
  removeHeadingIdAttrs,
  toAbsoluteUrl
} from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const data = post.data;
const slug = post.id;

// ===== 与 build.js 相同的处理流程 =====
const markdown = post.body ?? '';
const readingTime = calcReadingTime(markdown);
const seo = generateSEOTags(data, slug);
const license = getLicenseDisplayAndHtml(data);
const tagsStr = normalizeTags(data.tags);
const tagsHtml = tagsStr
  ? tagsStr
      .split(', ')
      .map(
        (t) =>
          `<a href="/?tag=${encodeURIComponent(t)}" class="article-tag" data-tag="${t.replace(/"/g, '&quot;')}">${t}</a>`
      )
      .join('')
  : '';

// ===== [cover] 可选封面：正文前的头图 + og:image / twitter:image =====
const coverUrl = data.cover ? toAbsoluteUrl(data.cover) : '';

// 正文 HTML：Astro 内置 Markdown 渲染（替代 marked.parse），
// 再做文本转义后处理使产物与旧版 marked 输出一致。
// marked 的块级输出以单个换行结尾且无前导空白，此处对齐该形状。
const container = await AstroContainer.create();
let htmlContent = await container.renderToString(PostBody, { props: { post } });
htmlContent = removeHeadingIdAttrs(markedizeAstroHtml(htmlContent));
htmlContent = htmlContent.replace(/^\s+/, '');
if (htmlContent && !htmlContent.endsWith('\n')) htmlContent += '\n';

// Giscus 评论区（懒加载，见 Giscus.astro）
const giscusHtml = (await container.renderToString(Giscus)).replace(/^\s+|\s+$/g, '');

// 主脚本：与旧版一致包裹在 IIFE 内、body 末尾内联执行
const articleScriptTag = `\n    <script>\n        (function() {${articleJs}        })();\n    </script>`;

---

<BaseLayout
  title={`${data.title} - xundei's blog`}
  description={seo.metaDescription}
  keywords={tagsStr}
  canonical={seo.canonicalUrl}
  ogType="article"
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  ogUrl={seo.ogUrl}
  ogImage={coverUrl || undefined}
  twitterCard={coverUrl ? 'summary_large_image' : 'summary'}
  jsonLd={seo.jsonLD}
>
  <LoadingOverlay />
  <ArticleOverlays />

  <div class="container">
    <div class="article-container glass" id="article-container">
      <div class="article-header">
        <h1 class="article-title">{data.title}</h1>
        <div class="article-meta">
          <div>
            <span id="article-date">{data.date}</span>
            <span id="article-latest" data-latest={data.latest ?? ''} style="display:none;">
              <span> | </span>
              <span class="latest-label">更新于 <span id="article-latest-time"></span></span>
            </span>
            <span> | </span>
            <span id="article-category">{getCategoryName(data.category)}</span>
            <!-- 不蒜子页面 PV -->
            <span> | </span>
            <span>阅读量: <span id="busuanzi_page_pv">加载中...</span> 次</span>
          </div>
          <div class="reading-time">预计阅读时间: {readingTime} 分钟</div>
        </div>
        <div class="article-tags-bar" set:html={tagsHtml} />
      </div>
      {data.cover && (
        <figure class="article-cover">
          <img src={data.cover} alt={data.title} loading="eager" decoding="async" />
        </figure>
      )}
      <div class="article-full-content" set:html={htmlContent} />
    </div>

    <footer class="article-footer" id="article-footer" style={license.display ? 'display: none;' : undefined}>
      <div class="footer-content" set:html={license.html} />
    </footer>

    {giscusHtml && <Fragment set:html={giscusHtml} />}
  </div>

  <Fragment set:html={articleScriptTag} />
</BaseLayout>
