---
// 首页：结构与样式已从旧版 frame 移植为 Layout + 组件 + home.css / home.js。
// [v2] 桌面端侧栏（日历/标签云/归档）：三卡数据全部来自构建期 Content Collections
//   元数据（与 articles.json 同源同排序）；<1280px 侧栏整体隐藏退回单栏。
// [v5] ≥1280px 三栏杂志式 grid（左右侧栏 sticky），DOM 顺序文章流在前（SEO）。
// [v3.0.3] 文章卡片：整卡跳转 + 封面缩略图 + 悬浮右侧渐变遮罩，无详情弹窗。
// [collection] 文章合集：合集在文章流里占一张卡片（kind='collection'），与未归属文章按
//   latest||date 混排在同一条时间线上（合集不置顶，见 home.js 的 buildFeedItems）；
//   悬浮时用「这是一个文章合集，点击查看详细」覆盖简介；点击原地把列表切换成该合集的成员文章
//   （URL 记为 /?collection=<slug>，支持深链与浏览器前进后退）。成员文章默认不再单独出现，
//   但分类/搜索/标签/日期筛选时会展开，保证仍可被检索到。合集数据来自 /collections.json。
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoArticleNav from '../components/home/SeoArticleNav.astro';
import SearchPanel from '../components/home/SearchPanel.astro';
import LoadingOverlay from '../components/LoadingOverlay.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import SidebarLeft from '../components/home/SidebarLeft.astro';
import SidebarRight from '../components/home/SidebarRight.astro';
import AboutCard from '../components/home/AboutCard.astro';
import FuncCard from '../components/home/FuncCard.astro';
import homeJs from '../scripts/home.js?raw';
import homeSidebarJs from '../scripts/home-sidebar.js?raw';
import '../styles/home.css';
import { sortByArticlesOrder, buildLegacyIndexItem } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const postsSrcDir = path.resolve(process.cwd(), 'src/content/posts');
const articlesIndex = sortByArticlesOrder(
  posts.map((p) => buildLegacyIndexItem(p, postsSrcDir))
) as Array<Record<string, any>>;

// ===== 硬编码文章链接（供爬虫直接抓取）——逻辑复刻 build.js injectArticleLinks() =====
const seoLinks = articlesIndex
  .filter((a) => a.category !== 'friend_link')
  .map((a) => ({ url: String(a.url), title: String(a.title) }));

// ===== [v2] 侧栏数据（构建期生成；friend_link 与文章流口径一致，不参与三卡） =====
const slugOf = (filename: unknown) => String(filename).replace(/^blog\//, '').replace(/\.md$/, '');

// 日历卡：日期 → 当天最新一篇（articlesIndex 已按 latest||date 倒序，同一天首见即最新）
const postsByDate: Record<string, { u: string; t: string }> = {};
for (const a of articlesIndex) {
  if (a.category === 'friend_link') continue;
  const day = String(a.date).slice(0, 10);
  if (!postsByDate[day]) {
    postsByDate[day] = { u: '/articles/' + slugOf(a.filename), t: String(a.title) };
  }
}

// 标签云卡：按文章数降序、名称升序；字号按数量分 3 档（tag-s3 最大）
const tagCounts = new Map<string, number>();
for (const a of articlesIndex) {
  if (a.category === 'friend_link') continue;
  for (const raw of String(a.tags || '').split(', ')) {
    const t = raw.trim();
    if (t) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  }
}
const tagList = [...tagCounts.entries()].sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0]));
const tierSize = Math.max(1, Math.ceil(tagList.length / 3));
const tierOf = (i: number) => (i < tierSize ? 3 : i < tierSize * 2 ? 2 : 1);
const tagItems = tagList.map(([tag, count], i) => ({ tag, count, tier: tierOf(i) }));

// 归档卡：按年月分组的时间线（倒序），条目为 日期 + 标题
const archiveMap = new Map<string, { label: string; items: Array<{ href: string; date: string; title: string }> }>();
const archiveMonths: Array<{ label: string; items: Array<{ href: string; date: string; title: string }> }> = [];
for (const a of articlesIndex) {
  if (a.category === 'friend_link') continue;
  const d = String(a.date);
  const ym = d.slice(0, 7);
  if (!archiveMap.has(ym)) {
    const month = { label: `${Number(ym.slice(0, 4))}年${Number(ym.slice(5, 7))}月`, items: [] };
    archiveMap.set(ym, month);
    archiveMonths.push(month);
  }
  archiveMap.get(ym)!.items.push({
    href: '/articles/' + slugOf(a.filename),
    date: `${Number(d.slice(5, 7))}月${Number(d.slice(8, 10))}日`,
    title: String(a.title),
  });
}

// 日历数据：注入 window 供 home-sidebar.js 读取（< 转义防 </script> 截断）
const sidebarDataJson = JSON.stringify(postsByDate).replace(/</g, '\\u003c');
---

<BaseLayout
  title="xundei's blog——仰望星空，脚踏实地"
  description="xundei的个人博客——仰望星空，脚踏实地"
  canonical="https://xundei.qzz.io/"
  ogType="website"
  ogTitle="xundei's blog"
  ogDescription="xundei的个人博客——仰望星空，脚踏实地"
  ogUrl="https://xundei.qzz.io/"
  ogSiteName="xundei's blog——仰望星空，脚踏实地"
  jsonLd={`{ "@context": "https://schema.org", "@type": "WebSite", "name": "xundei's blog", "url": "https://xundei.qzz.io/" }`}
>
  <div class="container">
    <SeoArticleNav links={seoLinks} />
    <HomeHeader />

    <div class="home-layout">
      <main>
        <div class="articles-grid" id="articles-grid">
          <div class="loading-container">
            <div class="loader"></div>
          </div>
        </div>
        <div class="pagination-container" id="pagination-container"></div>
      </main>

      <SidebarLeft tags={tagItems} />
      <SidebarRight months={archiveMonths} />
    </div>

    <HomeFooter />
  </div>

  <SearchPanel />
  <LoadingOverlay />
  <AboutCard />
  <FuncCard />
  <div class="toast-container" id="toast-container"></div>

  <Fragment set:html={`\n  <script>window.__SIDEBAR_POSTS_BY_DATE=${sidebarDataJson};</script>`} />
  <Fragment set:html={`\n  <script>\n    (function() {${homeJs}    })();\n  </script>`} />
  <Fragment set:html={`\n  <script>\n${homeSidebarJs}\n  </script>`} />
</BaseLayout>
